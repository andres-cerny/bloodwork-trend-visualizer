{
  "name": "bloodwork-web-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:bloodwork",
    "build": "npm run build:bloodwork && npm run build:chat",
    "test": "vitest run",
    "deploy": "npm run deploy:agent && npm run deploy:extract && npm run deploy:bloodwork && npm run deploy:chat",
    "test:parity": "cd tools/pipeline && python3 tests/test_parity.py && cd ../.. && vitest run --project lab-core parity",
    "test:all": "npm run test:parity && vitest run && npm run test:hooks && npm run typecheck && npm run docs:check && npm run build && npm run check:bundle",
    "test:live": "vitest run --config tests/config/vitest.handoff.config.ts tests/live",
    "test:e2e": "npm run build:bloodwork && vitest run --config tests/config/vitest.handoff.config.ts tests/e2e/visual.e2e.ts",
    "test:audit": "npm run build:bloodwork && vitest run --config tests/config/vitest.handoff.config.ts tests/e2e/audit.e2e.ts",
    "test:handoff": "npm run test:e2e && npm run test:live",
    "check:bundle": "npm run check:bundle:bloodwork && npm run check:bundle:chat",
    "bench:stage0": "vitest run --config tests/bench/vitest.config.ts tests/bench/stage0.bench.ts",
    "bench:latency": "vitest run --config tests/bench/vitest.config.ts tests/bench/latency.bench.ts",
    "bench:accuracy": "vitest run --config tests/bench/vitest.config.ts tests/bench/accuracy.bench.ts",
    "bench:colmap": "vitest run --config tests/bench/vitest.config.ts tests/bench/columnmap_eval.bench.ts",
    "bench:x": "vitest run --config tests/bench/vitest.config.ts tests/bench/xcolumns.bench.ts",
    "bench:batch": "vitest run --config tests/bench/vitest.config.ts tests/bench/batch.bench.ts",
    "bench:triage": "vitest run --config tests/bench/vitest.config.ts tests/bench/triage.bench.ts",
    "bench:docling": "vitest run --config tests/bench/vitest.config.ts tests/bench/docling_eval.bench.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test:hooks": "node .claude/hooks/hooks.test.mjs",
    "dev:agent": "npm -w workers/agent run dev -- --port 8788",
    "dev:extract": "npm -w workers/extract run dev -- --port 8787",
    "dev:bloodwork": "npm -w apps/bloodwork run dev",
    "build:bloodwork": "npm -w apps/bloodwork run build",
    "deploy:agent": "npm -w workers/agent run deploy",
    "deploy:extract": "npm -w workers/extract run deploy",
    "deploy:bloodwork": "npm run build:bloodwork && npm run check:bundle:bloodwork && npm -w apps/bloodwork run deploy",
    "check:bundle:bloodwork": "node tools/scripts/check-bundle.mjs apps/bloodwork/dist",
    "dev:chat": "npm -w apps/chat run dev",
    "build:chat": "npm -w apps/chat run build",
    "check:bundle:chat": "node tools/scripts/check-bundle.mjs apps/chat/dist",
    "deploy:chat": "npm run build:chat && npm run check:bundle:chat && npm -w apps/chat run deploy",
    "eval": "vitest run --config tests/config/vitest.eval.config.ts",
    "docs:check": "node tools/scripts/check-docs.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@bw/agent-core": "*",
    "@bw/extraction": "*",
    "@bw/gate": "*",
    "@bw/lab-core": "*",
    "@anthropic-ai/sdk": "^0.120.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@bw/api-client": "*",
    "@bw/ui-kit": "*",
    "@bw/datasource": "*",
    "@bw/agent-tools": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.125.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/agent/*",
    "workers/*"
  ]
}
