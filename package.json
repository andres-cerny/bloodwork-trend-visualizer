{
  "name": "bloodwork-web-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && npm run check:bundle && wrangler deploy",
    "test:parity": "python3 tests/test_parity.py && vitest run tests/parity.test.ts",
    "test:all": "npm run test:parity && vitest run && npm run test:hooks && npm run typecheck",
    "test:live": "vitest run --config config/vitest.handoff.config.ts tests/live",
    "test:e2e": "npm run build && vitest run --config config/vitest.handoff.config.ts e2e/visual.e2e.ts",
    "test:audit": "npm run build && vitest run --config config/vitest.handoff.config.ts e2e/audit.e2e.ts",
    "test:handoff": "npm run test:e2e && npm run test:live",
    "check:bundle": "node scripts/check-bundle.mjs",
    "bench:stage0": "vitest run --config bench/vitest.config.ts bench/stage0.bench.ts",
    "bench:latency": "vitest run --config bench/vitest.config.ts bench/latency.bench.ts",
    "bench:accuracy": "vitest run --config bench/vitest.config.ts bench/accuracy.bench.ts",
    "bench:colmap": "vitest run --config bench/vitest.config.ts bench/columnmap_eval.bench.ts",
    "bench:x": "vitest run --config bench/vitest.config.ts bench/xcolumns.bench.ts",
    "bench:batch": "vitest run --config bench/vitest.config.ts bench/batch.bench.ts",
    "bench:triage": "vitest run --config bench/vitest.config.ts bench/triage.bench.ts",
    "bench:docling": "vitest run --config bench/vitest.config.ts bench/docling_eval.bench.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "test:hooks": "node .claude/hooks/privacy-guard.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.125.0"
  }
}
