{
  /*
   * The repo's tooling: benchmarks, e2e suites, and the live API tests.
   *
   * These were outside the typecheck entirely — `tsconfig.json` referenced only
   * the web app and the Worker — while being exactly the code that reaches
   * across directories by relative path (`../web/src/lib`, `../../worker`).
   * Nothing checked those paths, and `npm test` does not run these files
   * either, so two real defects sat here undetected: an import of a
   * `SCREEN_SUBSET` that `corpus.ts` never exported, and a `ctx.skip(reason)`
   * call whose argument vitest 2 does not accept.
   *
   * Deliberately NOT a referenced project. A referenced project must be
   * `composite`, and composite requires every file in the program to be matched
   * by this file's `include` — but these files import `web/src` and `worker`
   * sources, which belong to the other projects. It runs as its own tsc pass
   * instead; see the `typecheck` script.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["bench/**/*.ts", "e2e/**/*.ts", "tests/live/**/*.ts"]
}
