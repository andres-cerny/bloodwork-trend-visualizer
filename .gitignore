# Python. This is a macOS workspace; the Windows PC the project started on is
# gone, and .venv/Scripts was deleted with it.
.venv/
.venv-mac/
__pycache__/
*.pyc

# Throwaway driver scripts (Playwright harnesses, one-off probes)
.eval*.mjs
.shot.mjs
.gaps.mjs

# Node / web build
node_modules/
dist/
.wrangler/

# Secrets / config
.env
.dev.vars
.streamlit/secrets.toml

# Claude Code config. The shared parts are committed — hooks and skills are
# project infrastructure, and a privacy guard that only exists on one machine
# guards nothing. Personal overrides stay local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
.claude/settings.local.json

# Personal medical data — NEVER commit
# Source lab reports and everything derived from them. Everything under
# samples/ except the README — subdirectories and non-PDF exports included;
# `samples/*.pdf` once left samples/performance/ and an .xlsx stageable.
data/
samples/*
!samples/README.md
apps/bloodwork/public/demo/real/


# TypeScript incremental build cache
*.tsbuildinfo

# Benchmark outputs — derived from real lab PDFs, same rule as data/
tests/bench/results/

# Eval runs hold model answers about a patient. The baseline is committed,
# because a baseline nobody else has cannot detect a regression on their machine.
tests/evals/output/*
!tests/evals/output/baseline.json

# Playwright MCP scratch (snapshots, console logs from browser sessions)
.playwright-mcp/

# Editor settings are shared: the explorer should show the repo, not what it
# generates. Personal overrides go in .vscode/settings.local.json.
.vscode/*
!.vscode/settings.json

# Finder noise
.DS_Store
