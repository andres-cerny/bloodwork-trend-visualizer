# Python
.venv/
__pycache__/
*.pyc

# Throwaway driver scripts (Playwright harnesses, one-off probes)
.eval*.mjs
.shot.mjs
.gaps.mjs

# Node / web build
node_modules/
dist/
.wrangler/

# Secrets / config
.env
.dev.vars
.streamlit/secrets.toml

# Claude Code config. The shared parts are committed — hooks and skills are
# project infrastructure, and a privacy guard that only exists on one machine
# guards nothing. Personal overrides stay local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/settings.local.json

# Personal medical data — NEVER commit
# Source lab PDFs and everything derived from them.
data/
samples/*.pdf
apps/bloodwork/public/demo/real/

# macOS venv (the checked-in .venv layout is Windows-only)
.venv-mac/

# TypeScript incremental build cache
*.tsbuildinfo

# Benchmark outputs — derived from real lab PDFs, same rule as data/
bench/results/

# Playwright MCP scratch (snapshots, console logs from browser sessions)
.playwright-mcp/
