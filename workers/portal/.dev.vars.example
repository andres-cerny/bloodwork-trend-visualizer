# Copy to .dev.vars (git-ignored) for local development.
# Any random string works locally; production gets a real one via
#   npx wrangler secret put SESSION_SECRET
SESSION_SECRET=local-dev-secret-change-me

# Optional: the account the public "Zobrazit demo pacienta" link opens.
# Leave it out and the link is not shown. Locally this is whatever address
# you registered with; in production it is a wrangler secret, never a var.
# DEMO_EMAIL=ja@example.com

# Optional: the open door, locally. OPEN_SIGNUP lets an address register
# with no code; without RESEND_API_KEY the link is printed in this terminal
# instead of mailed. The bypass lets the local app — which has no Turnstile
# site key — post the forms without a token. Both are for .dev.vars only:
# production sets OPEN_SIGNUP in wrangler.jsonc and never sets the bypass.
# OPEN_SIGNUP=true
# OPEN_SIGNUP_DEV_BYPASS=true
