{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bloodwork-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // No assets. Reachable only through the app shells' service bindings, so
  // there is no second public origin to defend.
  "workers_dev": false,

  "kv_namespaces": [
    { "binding": "BUDGET", "id": "1a27795146e44c9092169ad7c86fa882" },
    // Evidence images for the one real patient record (seeded at deploy time,
    // never committed): synthetic pages ship as static assets, these cannot,
    // because dist/ is tracked and real pixels must never enter git. KV, not
    // R2, because R2 needs a dashboard opt-in this account has not made and
    // a page PNG sits far under KV's 25MB value cap.
    { "binding": "EVIDENCE", "id": "497ec72382db47288ba3703f61deb434" }
  ],

  // One database per practice — isolation by database, not by column, so a
  // query cannot forget a WHERE tenant clause that never exists. The tenant
  // slug from the URL path picks the binding; an unknown slug is refused.
  "d1_databases": [
    { "binding": "DB_SPORT", "database_name": "bloodwork-chat-sport", "database_id": "9e137169-3517-401f-bf6d-e7575d7981d4" },
    { "binding": "DB_ORTO", "database_name": "bloodwork-chat-orto", "database_id": "01ba4f51-1520-4b80-bef6-342abe4c1d74" }
  ],

  "vars": {
    // Both shells' hostnames: the bloodwork app minted its sessions through
    // extract until now, but chat can only reach this worker — and a token
    // proves where it was solved, so the list must name the chat host. Never
    // localhost here; .dev.vars carries that for dev.
    // The four `-a/-r1/-r2/-r3` hosts are the UI tournament's candidates, put
    // side by side for Ondrej to judge in a browser rather than in screenshots.
    // They are shells only — one agent, one pair of databases, one ledger
    // behind all of them — so they cost nothing extra and are deleted with a
    // `wrangler delete` once the pick is merged.
    "TURNSTILE_HOSTNAMES": "bloodwork-chat.andres-cerny.workers.dev,bloodwork-demo.andres-cerny.workers.dev,bloodwork-chat-a.andres-cerny.workers.dev,bloodwork-chat-r1.andres-cerny.workers.dev,bloodwork-chat-r2.andres-cerny.workers.dev,bloodwork-chat-r3.andres-cerny.workers.dev",
    "BUDGET_USD_LIMIT": "40",
    "CLINICAL_USD_LIMIT": "10",
    "SESSION_TTL_SECONDS": "1800"
  },

  "observability": { "enabled": true }

  // Secrets: ANTHROPIC_API_KEY, TURNSTILE_SECRET_KEY, SESSION_SECRET
}
